# ─── Site ────────────────────────────────────────────────────────────────
# Public origin used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://nextgenroofing.work
# Set to "true" on preview/staging deployments to block indexing.
NEXT_PUBLIC_NOINDEX=false
# Homepage hero: "video" (Concept A, default) or "stills" (Concept B).
NEXT_PUBLIC_HERO_CONCEPT=video

# ─── Roof estimator ──────────────────────────────────────────────────────
# Optional: force a mode. "inspection-only" disables online pricing.
# ESTIMATOR_MODE=inspection-only
# config/pricing.json is approved for BALLPARK ranges ("status": "ballpark").
# ALLOW_DEMO_PRICING only matters if the status is set back to "demonstration".
ALLOW_DEMO_PRICING=false
# Approved pricing (server-side only). Use ONE of these, or edit config/pricing.json.
# PRICING_CONFIG_PATH=/run/secrets/pricing.json
# PRICING_CONFIG_JSON={"version":"...","status":"approved",...}

# ─── Lead delivery ───────────────────────────────────────────────────────
# Comma-separated sinks: google-sheet, email, webhook, file. A request succeeds only if at
# least one configured sink accepts it. With none configured in production,
# forms show "unavailable — please call" instead of a fake success.
LEAD_SINKS=google-sheet

# google-sheet — Apps Script web app on the "Lead form requests - Website" sheet;
# appends a row AND emails the NextGen Gmail. Setup: integrations/google-sheets/README.md
LEAD_SHEET_WEBHOOK_URL=
LEAD_SHEET_TOKEN=

# email — via Resend (https://resend.com). Requires a verified sending domain.
RESEND_API_KEY=
LEAD_EMAIL_FROM="NextGen Website <leads@your-domain.com>"
LEAD_EMAIL_TO=owner@your-domain.com

# webhook — e.g. a Zapier/Make/n8n hook or Google Apps Script that appends to a Sheet / CRM.
LEAD_WEBHOOK_URL=
# Optional HMAC secret; requests carry x-nextgen-signature: sha256=<hex>
LEAD_WEBHOOK_SECRET=

# file — JSONL on a PERSISTENT disk (self-hosted only; ignored in production without a dir).
# LEAD_FILE_DIR=/var/lib/nextgen/leads

# Submissions per IP per 10 minutes (per server instance). Default 5.
# LEAD_RATE_LIMIT=5

# ─── Spam protection (optional) ──────────────────────────────────────────
# Cloudflare Turnstile (free). When both are set the widget renders and is verified server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Search & analytics (optional; nothing loads unless set) ─────────────
# GA4 measurement ID (e.g. G-XXXXXXXXXX). Enables page views + events:
#   generate_lead (confirmed form submissions), estimate_complete, click_to_call.
# The Privacy Policy automatically switches to its analytics wording when this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification code (only if not verifying the domain via DNS).
NEXT_PUBLIC_GSC_VERIFICATION=
