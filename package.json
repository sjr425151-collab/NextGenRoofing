{
  "name": "nextgen-roofing",
  "version": "1.0.0",
  "private": true,
  "description": "NextGen Roofing & Construction LLC \u2014 website, roof estimator and lead capture",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "media": "scripts/media/process-footage.sh",
    "build:preview": "node scripts/with-env.cjs .env.preview build",
    "start:preview": "node scripts/with-env.cjs .env.preview start",
    "check:preview": "BASE=http://localhost:${PORT:-3000}/preview/nextgenroofing node scripts/check-subpath.cjs",
    "build:render": "NEXT_BUILD_CPUS=1 NODE_OPTIONS=--max-old-space-size=320 node scripts/with-env.cjs .env.live build --webpack",
    "build:live": "node scripts/with-env.cjs .env.live build",
    "start:live": "node scripts/with-env.cjs .env.live start",
    "build:render-preview": "NEXT_BUILD_CPUS=1 NODE_OPTIONS=--max-old-space-size=320 node scripts/with-env.cjs .env.preview build --webpack"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
